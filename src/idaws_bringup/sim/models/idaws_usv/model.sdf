<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="idaws_usv">
    <pose>0 0 0.05 0 0 0</pose>

    <!-- Base hull -->
    <link name="base_link">
      <inertial>
        <mass>12.0</mass>
        <inertia>
          <ixx>0.465</ixx>
          <iyy>1.53</iyy>
          <izz>1.8</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="hull_collision">
        <geometry>
          <box><size>1.2 0.6 0.3</size></box>
        </geometry>
      </collision>
      <visual name="hull_visual">
        <geometry>
          <box><size>1.2 0.6 0.3</size></box>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.6 1</ambient>
          <diffuse>0.3 0.3 0.7 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- IMU link -->
    <link name="imu_link">
      <pose>0 0 0.1 0 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <iyy>0.0001</iyy>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      <sensor name="imu_sensor" type="imu">
        <always_on>1</always_on>
        <update_rate>200</update_rate>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.01</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.01</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.01</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.1</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.1</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.1</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>
    </link>
    <joint name="imu_joint" type="fixed">
      <parent>base_link</parent>
      <child>imu_link</child>
    </joint>

    <!-- LiDAR link -->
    <link name="lidar_link">
      <pose>0.3 0 0.25 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.001</ixx>
          <iyy>0.001</iyy>
          <izz>0.001</izz>
        </inertia>
      </inertial>
      <collision name="lidar_collision">
        <geometry>
          <cylinder><radius>0.035</radius><length>0.06</length></cylinder>
        </geometry>
      </collision>
      <visual name="lidar_visual">
        <geometry>
          <cylinder><radius>0.035</radius><length>0.06</length></cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>
      <sensor name="gpu_lidar" type="gpu_lidar">
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <visualize>1</visualize>
        <ray>
          <scan>
            <horizontal>
              <samples>720</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.15</min>
            <max>12.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.005</stddev>
          </noise>
        </ray>
      </sensor>
    </link>
    <joint name="lidar_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_link</child>
    </joint>

    <!-- Left propeller -->
    <link name="left_propeller">
      <pose>-0.5 0.25 -0.1 0 0 0</pose>
      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.0004</ixx>
          <iyy>0.0004</iyy>
          <izz>0.0004</izz>
        </inertia>
      </inertial>
      <visual name="left_prop_visual">
        <geometry>
          <cylinder><radius>0.05</radius><length>0.02</length></cylinder>
        </geometry>
        <material>
          <ambient>0.8 0.2 0.2 1</ambient>
          <diffuse>0.9 0.3 0.3 1</diffuse>
        </material>
      </visual>
    </link>
    <joint name="left_propeller_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_propeller</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
      </axis>
    </joint>

    <!-- Right propeller -->
    <link name="right_propeller">
      <pose>-0.5 -0.25 -0.1 0 0 0</pose>
      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.0004</ixx>
          <iyy>0.0004</iyy>
          <izz>0.0004</izz>
        </inertia>
      </inertial>
      <visual name="right_prop_visual">
        <geometry>
          <cylinder><radius>0.05</radius><length>0.02</length></cylinder>
        </geometry>
        <material>
          <ambient>0.2 0.8 0.2 1</ambient>
          <diffuse>0.3 0.9 0.3 1</diffuse>
        </material>
      </visual>
    </link>
    <joint name="right_propeller_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_propeller</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
      </axis>
    </joint>

    <!-- ArduPilot plugin -->
    <plugin name="ArduPilotPlugin" filename="ArduPilotPlugin">
      <fdm_addr>127.0.0.1</fdm_addr>
      <fdm_port_in>9002</fdm_port_in>
      <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
      <lock_step>0</lock_step>

      <modelXYZToAirplaneXForwardZDown degrees="true">0 0 0 180 0 0</modelXYZToAirplaneXForwardZDown>
      <gazeboXYZToNED degrees="true">0 0 0 180 0 90</gazeboXYZToNED>

      <imuName>imu_link::imu_sensor</imuName>

      <!-- Channel 0: SERVO1 = ThrottleLeft -->
      <control channel="0">
        <jointName>left_propeller_joint</jointName>
        <useForce>1</useForce>
        <multiplier>100</multiplier>
        <offset>-0.5</offset>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>VELOCITY</type>
        <p_gain>0.2</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>100</cmd_max>
        <cmd_min>-100</cmd_min>
      </control>

      <!-- Channel 2: SERVO3 = ThrottleRight -->
      <control channel="2">
        <jointName>right_propeller_joint</jointName>
        <useForce>1</useForce>
        <multiplier>100</multiplier>
        <offset>-0.5</offset>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>VELOCITY</type>
        <p_gain>0.2</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>100</cmd_max>
        <cmd_min>-100</cmd_min>
      </control>
    </plugin>

  </model>
</sdf>
