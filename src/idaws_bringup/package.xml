<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>idaws_bringup</name>
  <version>1.0.0</version>
  <description>IDAWS USV launch and configuration files</description>
  <maintainer email="team@idaws.dev">IDAWS Team</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>idaws_nodes</exec_depend>
  <exec_depend>idaws_msgs</exec_depend>
  <exec_depend>sllidar_ros2</exec_depend>
  <!-- Sadece simülasyon (sim/launch/sim_launch.py) için gerekli -->
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_image</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
