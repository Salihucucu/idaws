<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="idaws_lake">

    <!-- Physics -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- System plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>

    <!-- Buoyancy -->
    <plugin filename="gz-sim-buoyancy-system" name="gz::sim::systems::Buoyancy">
      <uniform_fluid_density>1000</uniform_fluid_density>
    </plugin>

    <!-- Spherical coordinates (Istanbul area) -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>41.015</latitude_deg>
      <longitude_deg>28.979</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <!-- Lighting -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 100 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Water surface (visual ground plane) -->
    <model name="water_surface">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="water_link">
        <visual name="water_visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>200 200</size></plane>
          </geometry>
          <material>
            <ambient>0.0 0.15 0.4 0.8</ambient>
            <diffuse>0.0 0.2 0.5 0.8</diffuse>
          </material>
        </visual>
        <collision name="water_collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>200 200</size></plane>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- USV -->
    <include>
      <uri>model://idaws_usv</uri>
      <pose>0 0 0.15 0 0 0</pose>
    </include>

    <!-- Buoy obstacles -->
    <include>
      <uri>model://buoy_obstacle</uri>
      <name>buoy_1</name>
      <pose>8 2 0.3 0 0 0</pose>
    </include>
    <include>
      <uri>model://buoy_obstacle</uri>
      <name>buoy_2</name>
      <pose>15 -3 0.3 0 0 0</pose>
    </include>
    <include>
      <uri>model://buoy_obstacle</uri>
      <name>buoy_3</name>
      <pose>22 1 0.3 0 0 0</pose>
    </include>
    <include>
      <uri>model://buoy_obstacle</uri>
      <name>buoy_4</name>
      <pose>12 5 0.3 0 0 0</pose>
    </include>
    <include>
      <uri>model://buoy_obstacle</uri>
      <name>buoy_5</name>
      <pose>18 -6 0.3 0 0 0</pose>
    </include>

  </world>
</sdf>
